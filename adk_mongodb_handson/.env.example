# cp .env.example .env して値を編集してください。.env は Git に含めないこと。

# ---- MongoDB 接続先 (docker-compose.yml の既定ポートに対応) ----
MONGODB_URI_STANDALONE=mongodb://localhost:27117/?directConnection=true
MONGODB_URI_REPLICASET=mongodb://localhost:27118/?directConnection=true
MONGODB_URI_ATLAS_LOCAL=mongodb://localhost:27119/?directConnection=true

# ---- auth profile (Level 4: 認証と権限制御) ----
# docker compose の auth profile 起動時に必須。ローカル検証専用の値に変更してください。
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
ADK_APP_PASSWORD=
ADK_READER_PASSWORD=
ADK_NOINDEX_PASSWORD=
MONGO_AUTH_PORT=27120
HANDSON_AUTH_DB=adk_handson_auth

# ---- オプション: MongoDB Atlas (クラウド) ----
# 例: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Atlas 固有機能 (Automated Embedding など) を試す場合のみ設定する。
MONGODB_URI_ATLAS=

# ---- オプション: 実 LLM / Embedding (外部 API。未設定ならスキップされる) ----
# Gemini Developer API を使う場合
GOOGLE_API_KEY=
# Vertex AI を使う場合は GOOGLE_GENAI_USE_VERTEXAI=TRUE と下記を設定
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
ADK_MODEL=gemini-2.5-flash

# ---- テスト制御 ----
# 1 にすると MongoDB に接続できない場合にスキップではなく失敗させる (CI 用)
REQUIRE_MONGO=
